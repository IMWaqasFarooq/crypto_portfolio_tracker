# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment secrets - CoinGecko keys etc, never commit real values
assets/env/.env.development
assets/env/.env.production
*.jks
*.keystore
key.properties

# Firebase client config (apiKey/appId here identify the project but grant
# no access without security rules - Google's own guidance is these are
# safe to check in: https://firebase.google.com/docs/projects/api-keys).
# Committed intentionally so a fresh clone compiles and runs immediately.

# Generated code
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
