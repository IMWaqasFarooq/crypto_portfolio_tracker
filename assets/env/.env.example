# Copy this file to .env.development / .env.production and fill in real values.
# These files are gitignored and must never be committed.

# CoinGecko public API. Free tier works without a key; set one if you have
# a Demo/Pro plan to get higher rate limits.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Base delay used by the Dio retry interceptor, in milliseconds.
NETWORK_RETRY_BASE_DELAY_MS=500
NETWORK_MAX_RETRIES=3
NETWORK_CONNECT_TIMEOUT_MS=15000
NETWORK_RECEIVE_TIMEOUT_MS=15000

# Feature flags
ENABLE_NETWORK_LOGGING=true
